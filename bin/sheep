#!/bin/bash
# Sheep CLI — start, stop, and manage your mentor agent

# Resolve symlinks so this works from ~/.local/bin/sheep → ~/sheep/bin/sheep
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SHEEP_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
DASHBOARD_URL="http://localhost:3800"

pick_package_manager() {
  PREFERRED=""

  if [ -n "${SHEEP_PACKAGE_MANAGER:-}" ]; then
    PREFERRED="$SHEEP_PACKAGE_MANAGER"
  elif [ -f package-lock.json ] && { [ ! -f pnpm-lock.yaml ] || [ package-lock.json -nt pnpm-lock.yaml ]; }; then
    PREFERRED="npm"
  elif [ -f pnpm-lock.yaml ]; then
    PREFERRED="pnpm"
  fi

  for CANDIDATE in "$PREFERRED" pnpm npm; do
    [ -z "$CANDIDATE" ] && continue
    if command -v "$CANDIDATE" >/dev/null 2>&1; then
      echo "$CANDIDATE"
      return 0
    fi
  done

  echo ""
}

active_lockfile() {
  if [ "$PACKAGE_MANAGER" = "pnpm" ]; then
    echo "pnpm-lock.yaml"
  else
    echo "package-lock.json"
  fi
}

install_dependencies() {
  if [ "$PACKAGE_MANAGER" = "pnpm" ]; then
    pnpm install --silent
  else
    npm install --silent
  fi
}

run_script() {
  if [ "$PACKAGE_MANAGER" = "pnpm" ]; then
    pnpm "$1"
  else
    npm run "$1"
  fi
}

lockfile_is_newer() {
  LOCKFILE="$(active_lockfile)"
  [ -f "$LOCKFILE" ] && [ "$LOCKFILE" -nt node_modules ] && return 0
  return 1
}

stop_launchd_service() {
  command -v launchctl >/dev/null 2>&1 || return 1

  PLIST="$HOME/Library/LaunchAgents/com.sheep.plist"
  launchctl list | grep -q "com.sheep" || return 1

  if [ -f "$PLIST" ] && launchctl unload "$PLIST" >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

stop_systemd_service() {
  command -v systemctl >/dev/null 2>&1 || return 1
  systemctl --user is-active --quiet sheep || return 1
  systemctl --user stop sheep >/dev/null 2>&1
}

case "${1:-}" in

  install)
    cd "$SHEEP_DIR"
    bash "$SHEEP_DIR/scripts/install.sh"
    ;;

  shutdown)
    echo "Shutting down Sheep..."
    if stop_launchd_service || stop_systemd_service; then
      echo "Done."
    elif curl -sf -X POST "$DASHBOARD_URL/api/shutdown" > /dev/null 2>&1; then
      echo "Done."
    else
      # Dashboard not reachable — kill the process directly
      if pkill -f "$SHEEP_DIR/src/index.ts" 2>/dev/null || pkill -f "$SHEEP_DIR/dist/index.js" 2>/dev/null; then
        echo "Done."
      else
        echo "Sheep is not running."
      fi
    fi
    ;;

  restart)
    echo "Restarting Sheep..."
    if curl -sf -X POST "$DASHBOARD_URL/api/restart" > /dev/null 2>&1; then
      echo "Done."
    else
      echo "Sheep is not running. Use 'sheep' to start."
    fi
    ;;

  "")
    cd "$SHEEP_DIR"
    PACKAGE_MANAGER="$(pick_package_manager)"

    if [ -z "$PACKAGE_MANAGER" ]; then
      echo "Neither pnpm nor npm is installed."
      exit 1
    fi

    # Install deps if node_modules is missing or a lockfile is newer
    if [ ! -d node_modules ] || lockfile_is_newer; then
      echo "Installing dependencies..."
      install_dependencies
    fi

    # Build if dist/ is missing or source is newer
    if [ ! -d dist ] || find src -name "*.ts" -newer dist/index.js 2>/dev/null | grep -q .; then
      echo "Building..."
      run_script build
    fi

    # Run with auto-restart support
    while true; do
      run_script dev
      EXIT_CODE=$?
      [ "$EXIT_CODE" -eq 75 ] && { echo "Restarting..."; sleep 1; continue; }
      break
    done
    ;;

  *)
    echo "Usage: sheep install   # install Docker/deps, build, and wire the CLI"
    echo "       sheep           # install deps if needed, build, and start"
    echo "       sheep shutdown  # shut down"
    echo "       sheep restart   # restart"
    exit 1
    ;;

esac
